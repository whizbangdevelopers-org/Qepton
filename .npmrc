# An install whose dependency carries an install script that package.json's allowScripts does not
# name, or approves only at another version, FAILS before any script runs (ESTRICTALLOWSCRIPTS),
# instead of running it with a warning that nothing keeps. FORGE-121 (Every dependency version waits
# 6 days before a WBD repo or the sealed mirror adopts it; security updates get no automatic bypass,
# only an approved and recorded exception), point 3. audit:install-scripts fails without it.
strict-allow-scripts=true
